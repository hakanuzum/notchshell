#!/bin/sh
# notchshell — drop the terminal, optionally starting a tab in a directory.
#
# Installed into the app bundle and symlinked onto PATH from Settings. It shells out
# to `open` rather than talking to the control socket so it keeps working when the
# socket API is turned off — this is a person typing a command, not an external
# process driving the app, and it should not be gated like one.
#
# The file is called notchshell-cli inside the bundle because macOS filesystems are
# case-insensitive: a file named "notchshell" in Contents/MacOS *is* the app binary
# "Notchshell", and copying one over the other yields a bundle that cannot launch.
# The command name comes from the symlink, so this only affects the file on disk.

set -eu

# Resolve through the symlink on PATH to find the bundle we live in.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname "$self")/$link ;;
    esac
done
app=$(cd "$(dirname "$self")/../.." && pwd)   # …/Notchshell.app

# Whichever copy of the app is already running owns the bundle identifier, and macOS
# routes by identity rather than by path. Handing `open` a *different* copy of it — the
# everyday case being a build tree beside the installed app — is neither an error nor a
# launch: the request is dropped, nothing appears, and `open` still exits 0. Ask
# LaunchServices who is answering to our identifier and address that one instead, out
# loud, because a command that quietly drives a different copy than the one it lives in
# is its own kind of confusing.
bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null || true)
if [ -n "$bundle_id" ]; then
    asn=$(lsappinfo find "bundleid=$bundle_id" 2>/dev/null | head -1 || true)
    if [ -n "$asn" ]; then
        running=$(lsappinfo info -only bundlepath "$asn" 2>/dev/null |
                  sed -n 's/.*"LSBundlePath"="\([^"]*\)".*/\1/p' || true)
        running=${running%/}
        if [ -n "$running" ] && [ "$running" != "${app%/}" ]; then
            echo "notchshell: a different copy is already running; sending this there:" >&2
            echo "  $running" >&2
            app=$running
        fi
    fi
fi

usage() {
    cat <<EOF
usage: notchshell [path]

  no arguments   drop the terminal
  path           drop the terminal with a new tab there
                 (a file opens its containing folder)

Also reachable as:
  open -a "$app" <path>
  notchshell://<path>          URL scheme
  Finder > right click > Services > New Notchshell Tab Here
EOF
}

case "${1:-}" in
    -h|--help|help)
        usage
        ;;
    "")
        open -a "$app"
        ;;
    -*)
        echo "notchshell: unknown option $1" >&2
        usage >&2
        exit 2
        ;;
    *)
        if [ ! -e "$1" ]; then
            echo "notchshell: no such file or directory: $1" >&2
            exit 1
        fi
        # `open` does not inherit the caller's working directory.
        target=$(cd "$(dirname "$1")" && printf '%s/%s' "$(pwd)" "$(basename "$1")")
        open -a "$app" "$target"
        ;;
esac
