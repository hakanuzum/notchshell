+    /// An inline image from OSC 1337 File=, drawn through the Kitty graphics
+    /// machinery rather than through a second implementation of the same idea.
+    ///
+    /// The two protocols disagree about how an image is announced and agree about
+    /// what happens next: decode it, store it, place it at the cursor, move the
+    /// cursor past it. That second half already exists here, is already tested,
+    /// and already has a renderer behind it. So this translates one into the
+    /// other rather than growing a parallel path that would drift from it.
+    ///
+    /// PNG is handed over untouched, because Kitty's own transmission format
+    /// covers it and the decode happens downstream. JPEG has no place in that
+    /// format, so it is decoded here — wuffs is already vendored for the PNG
+    /// path — and handed over as raw RGBA. Anything else is dropped: a terminal
+    /// that guesses at a format it cannot read draws noise.
+    ///
+    /// Failures are logged and swallowed. A picture that will not decode is not
+    /// a reason to tear down the stream that carried it.
+    fn iterm2File(
+        self: *StreamHandler,
+        b64: []const u8,
+        columns: u32,
+        rows: u32,
+    ) void {
+        const alloc = self.alloc;
+
+        const decoder = std.base64.standard.Decoder;
+        const size = decoder.calcSizeForSlice(b64) catch {
+            log.warn("OSC 1337 File: payload is not valid base64", .{});
+            return;
+        };
+        const bytes = alloc.alloc(u8, size) catch return;
+        defer alloc.free(bytes);
+        decoder.decode(bytes, b64) catch {
+            log.warn("OSC 1337 File: payload is not valid base64", .{});
+            return;
+        };
+
+        const png_magic = "\x89PNG\r\n\x1a\n";
+        const jpeg_magic = "\xff\xd8\xff";
+
+        var transmission: terminal.kitty.graphics.Transmission = .{
+            .medium = .direct,
+        };
+        var payload: []const u8 = bytes;
+        var decoded: ?wuffs.ImageData = null;
+        defer if (decoded) |d| alloc.free(d.data);
+
+        if (std.mem.startsWith(u8, bytes, png_magic)) {
+            transmission.format = .png;
+        } else if (std.mem.startsWith(u8, bytes, jpeg_magic)) {
+            const image = wuffs.jpeg.decode(alloc, bytes) catch {
+                log.warn("OSC 1337 File: jpeg would not decode", .{});
+                return;
+            };
+            decoded = image;
+            transmission.format = .rgba;
+            transmission.width = image.width;
+            transmission.height = image.height;
+            payload = image.data;
+        } else {
+            log.warn("OSC 1337 File: unsupported image format", .{});
+            return;
+        }
+
+        transmission.size = std.math.cast(u32, payload.len) orelse {
+            log.warn("OSC 1337 File: image too large", .{});
+            return;
+        };
+
+        var cmd: terminal.kitty.graphics.Command = .{
+            .control = .{ .transmit_and_display = .{
+                .transmission = transmission,
+                .display = .{
+                    .columns = columns,
+                    .rows = rows,
+                    .cursor_movement = .after,
+                },
+            } },
+            .data = payload,
+        };
+
+        // The response is for a client that asked a question; this one did not,
+        // and iTerm2's protocol has nowhere to put an answer.
+        _ = self.terminal.kittyGraphics(alloc, &cmd);
+    }
