@@ -154,6 +154,70 @@ pub fn parse(parser: *Parser, _: ?u8) ?*Command {
             return &parser.command;
         },
 
+        // File=<args>:<base64> — an inline image.
+        //
+        // The arguments are `k=v` pairs separated by `;`, and the payload follows
+        // the first colon. Only `inline=1` draws: without it iTerm2 downloads the
+        // file instead, and a terminal that drew it anyway would put a picture on
+        // screen where the user asked for a saved file.
+        //
+        // `width` and `height` are taken only in their plain-number form, which
+        // means cells. iTerm2 also allows `Npx`, `N%` and `auto`; those resolve
+        // against a cell size and a window size that this layer does not know, so
+        // they fall through to zero, which the consumer reads as "natural size" —
+        // the same thing `auto` asks for, and a safe answer for the other two.
+        .File => {
+            const value = value_ orelse {
+                parser.command = .invalid;
+                return null;
+            };
+
+            const colon = std.mem.indexOfScalar(u8, value, ':') orelse {
+                parser.command = .invalid;
+                return null;
+            };
+
+            const args = value[0..colon];
+            const payload = value[colon + 1 .. value.len :0];
+            if (payload.len == 0) {
+                parser.command = .invalid;
+                return null;
+            }
+
+            var inline_display: bool = false;
+            var columns: u32 = 0;
+            var rows: u32 = 0;
+
+            var it = std.mem.splitScalar(u8, args, ';');
+            while (it.next()) |pair| {
+                const eql = std.mem.indexOfScalar(u8, pair, '=') orelse continue;
+                const name = pair[0..eql];
+                const val = pair[eql + 1 ..];
+                if (std.mem.eql(u8, name, "inline")) {
+                    inline_display = val.len > 0 and val[0] == '1';
+                } else if (std.mem.eql(u8, name, "width")) {
+                    columns = std.fmt.parseInt(u32, val, 10) catch 0;
+                } else if (std.mem.eql(u8, name, "height")) {
+                    rows = std.fmt.parseInt(u32, val, 10) catch 0;
+                }
+            }
+
+            if (!inline_display) {
+                log.debug("OSC 1337 File without inline=1, ignoring", .{});
+                parser.command = .invalid;
+                return null;
+            }
+
+            parser.command = .{
+                .iterm2_file = .{
+                    .data = payload,
+                    .columns = columns,
+                    .rows = rows,
+                },
+            };
+            return &parser.command;
+        },
+
         .AddAnnotation,
         .AddHiddenAnnotation,
         .Block,
@@ -165,7 +229,6 @@ pub fn parse(parser: *Parser, _: ?u8) ?*Command {
